# LLM Provider Configuration (OpenAI, Anthropic, etc. via Langchain)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sentinelx

# Authentication
SECRET_KEY=your_secret_key_here_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# n8n Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sentinelx
N8N_AUTH_TOKEN=your_n8n_auth_token_here
