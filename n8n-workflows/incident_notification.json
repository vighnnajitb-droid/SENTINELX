{
  "name": "Incident Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sentinelx-incident",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "channel": "security-alerts",
        "text": "=New high severity incident detected: {{$json.body.incident_title}}\nSeverity: {{$json.body.severity}}",
        "attachments": [],
        "otherOptions": {}
      },
      "name": "Slack (Mock)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Slack (Mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}